NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb://localhost:27017/mastplayer
REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:3000,https://your-production-frontend.com
BACKEND_URL=http://localhost:5001

JWT_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=videoupload
R2_PUBLIC_URL=
MEDIA_MAX_UPLOAD_BYTES=524288000

# Phase 5/6 — Instagram Graph + OAuth
META_GRAPH_API_VERSION=v26.0
IG_MEDIA_POLL_INTERVAL_MS=5000
IG_MEDIA_POLL_MAX_ATTEMPTS=36
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta / Facebook App ID from App Dashboard (different from Instagram App ID)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_REDIRECT_URI=

# Facebook Login — Valid OAuth Redirect URI in Meta:
# https://your-frontend/accounts/facebook/callback
FACEBOOK_REDIRECT_URI=http://localhost:3000/accounts/facebook/callback
# Facebook Login for Business → Configurations → copy Configuration ID
FACEBOOK_CONFIG_ID=1095044976738601
FACEBOOK_OAUTH_SCOPES=pages_manage_posts,pages_read_engagement,pages_show_list

# OAuth redirect URI to add in Meta App Dashboard (Instagram → API setup):
# {BACKEND_URL}/api/social/instagram/callback
# Example: http://localhost:5001/api/social/instagram/callback

# PUBLISH_WORKER_CONCURRENCY=5

# Instagram public link importer (third-party parser — never expose to frontend)
IG_AUTH=20250901majwlqo
IG_DOMAIN=api-ak.igvideodownloader.net
IG_PARSE_URL=https://api.igvideodownloader.net/api/contentsite_api/media/parse
IG_ORIGIN=https://igvideodownloader.net
# Optional: residential HTTP proxy if cloud IPs get "analyze failed"
# IG_HTTP_PROXY=http://user:pass@proxy-host:port
# Optional fallback if IG_AUTH is unset
# VIDSSAVE_AUTH=
